# Development Dockerfile with all tools
# Bun, plus a Node binary for the Nuxt build only. nuxt-og-image 7 (via
# @nuxtjs/seo 6) calls node:module's findPackageJSON, which Bun 1.4.4 does not
# implement; with node on PATH, the `nuxt` bin's `#!/usr/bin/env node` shebang
# runs it under Node, exactly as it does on a developer machine and in CI. Drop
# the COPY once Bun ships findPackageJSON. Same Debian (trixie) as the Bun image.
FROM oven/bun:1.4.4-slim

COPY --from=node:26.13.0-trixie-slim /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json bun.lock* ./
COPY packages/shared/package.json packages/shared/
COPY packages/client/package.json packages/client/
COPY packages/server/package.json packages/server/
COPY packages/admin/package.json packages/admin/
COPY packages/admin-ui/package.json packages/admin-ui/

# Install all dependencies
# `examples` is a dev-only workspace whose manifest is deliberately not copied
# into the image, so drop it from the workspace list before installing --
# otherwise bun aborts with `Workspace not found "examples"`.
RUN sed -i '/"examples"/d; s/"packages\/\*",/"packages\/*"/' package.json

# --ignore-scripts because the root `prepare` script runs `lefthook install`,
# which needs a .git directory the image does not have. The other half of that
# script is `bun run build`, which this Dockerfile already runs explicitly
# below, so nothing is lost.
RUN bun install --ignore-scripts

# Copy source files
COPY . .

# Build all packages
RUN bun run build

# Expose ports (9000: server, 3000: admin-ui dev)
EXPOSE 9000 3000

# Default command
CMD ["bun", "run", "dev"]
