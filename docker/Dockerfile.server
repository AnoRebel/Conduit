# Multi-stage build for Conduit server with optional admin API
FROM imbios/bun-node:1.3.14-24-debian AS builder

WORKDIR /app

# Copy workspace files
COPY package.json bun.lock* ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/admin/package.json packages/admin/

# Install dependencies (ignore scripts since source isn't copied yet)
RUN bun install --ignore-scripts

# Copy source files
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/server packages/server
COPY packages/admin packages/admin

# Build packages in order: shared -> server -> admin
RUN bun run build:shared && bun run build:server && bun run build:admin

# Production stage — debian slim for glibc compatibility (bun+musl has networking issues)
FROM oven/bun:1.3.14-slim AS production

WORKDIR /app

# Create a standalone package.json with only external runtime dependencies
RUN echo '{"name":"conduit-server","private":true,"type":"module","dependencies":{"commander":"^15.0.0","pino":"^10.3.1","ws":"^8.21.3","jsonwebtoken":"^9.0.3"}}' > package.json

# Install only external production dependencies and clean cache
RUN bun install --production --ignore-scripts && rm -rf /root/.bun/install/cache

# Overlay workspace packages with their actual built output
COPY --from=builder /app/packages/shared/dist ./node_modules/@conduit/shared/dist
COPY --from=builder /app/packages/shared/package.json ./node_modules/@conduit/shared/
COPY --from=builder /app/packages/admin/dist ./node_modules/@conduit/admin/dist
COPY --from=builder /app/packages/admin/package.json ./node_modules/@conduit/admin/

# Copy server build output and CLI
COPY --from=builder /app/packages/server/dist ./dist
COPY --from=builder /app/packages/server/bin ./bin

# Environment defaults (non-sensitive only)
ENV PORT=9000 \
    HOST=0.0.0.0 \
    ALLOW_DISCOVERY=false

# Expose port
EXPOSE ${PORT}

# Report whether the process is actually serving, not merely that the image
# built. Without this a crash-looping container still reports as deployed.
# Uses bun rather than curl/wget, which the slim base image does not ship.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
	CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||9000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"


# Run server (admin disabled by default in standalone server image).
# CONDUIT_KEY is read from the environment by the CLI rather than passed as
# --key: substituting a default here would hand the server the public
# "conduit" key, which it refuses, producing a crash loop whose error names a
# value the operator never set. Unset, the CLI reports exactly what to provide.
CMD ["/bin/sh", "-c", "exec bun run bin/conduit.js start --port \"${PORT}\" --host \"${HOST}\""]
